# Copy this file to .env.local and fill in the values from your Supabase dashboard.
# Never commit .env.local.
# Project URL: Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=
# Secret key (starts with sb_secret_): Project Settings -> API Keys -> Secret keys
SUPABASE_SECRET_KEY=
# Email notifications (Resend): resend.com -> API Keys -> Create API key (starts with re_)
RESEND_API_KEY=
# Where new form messages are emailed (comma-separate for more than one)
CONSULTATION_EMAIL_TO=
